<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Xcode has no INFOPLIST_KEY_ build setting for this one, and setting it
	     as INFOPLIST_KEY_UIFileSharingEnabled is silently dropped, so it has to
	     live here. The generated keys are merged into this file. Unlike the
	     export-compliance key, Xcode leaves this one alone. -->
	<!-- The launch screen: just the colour around the keys (Finish.bezel), black
	     lacquer in Dark and ivory in Light, so opening goes straight from it to
	     the piano with no blank white or black first. Set here rather than
	     generated, as the generated launch screen takes no colour. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>UIFileSharingEnabled</key>
	<true/>
	<!-- What "Open in GoPiano" is offered for: voice memos and other
	     recordings, to find the melody in, and MIDI files, to play. Alternate,
	     so GoPiano is offered beside the usual players but never takes over
	     as the default for opening audio. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Recording</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.audio</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>MIDI File</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.midi-audio</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
